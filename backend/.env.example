# Copy to backend/.env and fill in real values. Never commit .env.

# Database — use the least-privilege role from migration 003, not postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=iub_alumni
DB_USER=iub_app
DB_PASSWORD=

# JWT signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# React dev server origin for CORS. Ignored when SERVE_FRONTEND_DIR is set,
# because then there is no cross-origin request to permit.
FRONTEND_ORIGIN=http://localhost:5173

# --- Deployment ---------------------------------------------------------
# Serve the built frontend from FastAPI, so the whole system runs on one
# origin and CORS switches off entirely. Point at frontend/dist.
SERVE_FRONTEND_DIR=

# Emit Strict-Transport-Security. Set true ONLY once TLS actually works —
# browsers will refuse the plain-HTTP site for a year otherwise.
HTTPS_ENABLED=false

# Trust X-Forwarded-For. Only true behind a reverse proxy that really sets
# it; otherwise a client can spoof it and slip the login throttle.
BEHIND_PROXY=false

# Failed sign-ins allowed per Student ID and address, and the window.
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_SECONDS=300

# --- Backups (database/backup.py) ---------------------------------------
# Separate storage from the database machine. A backup on the same disk is
# not a backup.
BACKUP_DIR=backups
BACKUP_KEEP=14

# Passwords used by database/seed_users.py (development only)
SEED_ADMIN_PASSWORD=
SEED_FACULTY_PASSWORD=
SEED_ALUMNI_PASSWORD=
